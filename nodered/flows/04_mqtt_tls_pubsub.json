  {
    "id": "404000000000000c",
    "type": "function",
    "z": "4040000000000001",
    "name": "清理 MQTT 狀態",
    "func": "const text = String(msg.status?.text || \"\").toLowerCase();\nlet state = \"UNKNOWN\";\nlet fill = \"grey\";\nif (text.includes(\"connecting\")) {\n    state = \"CONNECTING\";\n    fill = \"yellow\";\n} else if (text.includes(\"disconnected\")) {\n    state = \"DISCONNECTED\";\n    fill = \"red\";\n} else if (text.includes(\"connected\")) {\n    state = \"CONNECTED\";\n    fill = \"green\";\n} else if (text.includes(\"failed\") || text.includes(\"error\")) {\n    state = \"ERROR\";\n    fill = \"red\";\n}\nmsg.diagnostic = {\n    kind: \"MQTT_STATUS\",\n    state,\n    checked_at: new Date().toISOString()\n};\ndelete msg.payload;\ndelete msg.status;\ndelete msg.source;\nnode.status({fill, shape: \"dot\", text: state});\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 430,
    "y": 440,
    "wires": [
      [
        "404000000000000d"
      ]
    ]
  },
