  {
    "id": "4030000000000006",
    "type": "function",
    "z": "4030000000000001",
    "name": "驗證溫度並換算",
    "func": "const value = msg.payload?.temp;\nif (typeof value !== \"number\" || !Number.isFinite(value)) {\n    return [null, { payload: { ok: false, reason: \"temp_not_number\" } }];\n}\nif (value < -20 || value > 80) {\n    return [null, { payload: { ok: false, reason: \"temp_out_of_range\" } }];\n}\nmsg.payload.temp_f = Math.round((value * 9 / 5 + 32) * 10) / 10;\nreturn [msg, null];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 620,
    "y": 170,
    "wires": [
